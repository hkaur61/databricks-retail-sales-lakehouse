   "source": [
    "\n",
    "SELECT\n",
    "    p.category,\n",
    "    SUM(f.sales_amount) AS revenue\n",
    "FROM retail_gold.fact_sales f\n",
    "JOIN retail_silver.products p\n",
    "    ON f.product_id = p.product_id\n",
    "GROUP BY p.category\n",
    "ORDER BY revenue DESC;\n",
    "\n",
    "\n"
   ]
  }
