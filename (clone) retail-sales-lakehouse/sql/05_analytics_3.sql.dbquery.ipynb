   "source": [
    "SELECT\n",
    "    c.state,\n",
    "    SUM(f.sales_amount) AS revenue\n",
    "FROM retail_gold.fact_sales f\n",
    "JOIN retail_silver.customers c\n",
    "    ON f.customer_id = c.customer_id\n",
    "GROUP BY c.state\n",
    "ORDER BY revenue DESC;"
   ]
  }
